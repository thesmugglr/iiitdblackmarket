VITE_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe publishable key from the Supabase project Connect/API keys section.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
# Existing installations can continue using VITE_SUPABASE_ANON_KEY instead.
# Never put sb_secret_, service_role, Google client secrets, or database passwords here.

# Local loopback app + local Supabase only (dev server): VITE_DEV_LOGIN=1
