{
  "name": "iiitdblackmarket",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev --workspace @iiitd/api\" \"npm run dev --workspace @iiitd/web\"",
    "dev:web": "npm run dev --workspace @iiitd/web",
    "dev:api": "npm run dev --workspace @iiitd/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
